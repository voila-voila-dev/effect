												{
													"type": "string",
													"enum": ["Infinity", "-Infinity", "NaN"]
												}
											]
										},
										"take": {
											"type": "integer",
											"minimum": 1,
											"maximum": 100
										},
										"skip": {
											"type": "integer"
										},
										"hasMore": {
											"type": "boolean"
										}
									},
									"required": ["items", "total", "take", "skip", "hasMore"],
									"additionalProperties": false
								}
							}
						}
					},
					"403": {
						"description": "AccessDeniedError",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AccessDeniedErrorEncoded"
								}
							}
						}
