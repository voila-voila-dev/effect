{
	"name": "@voila.dev/vies",
	"version": "0.0.0",
	"description": "EU VAT numbers on Effect: VIES checks with typed outages and refusals, the national formats of every member state, a parser for numbers as people type them, and an in-memory fake.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "domains/providers/packages/vies"
	},
	"homepage": "https://github.com/voila-voila-dev/platform/tree/main/domains/providers/packages/vies#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/platform/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"vies",
		"vat",
		"vat-number",
		"tva",
		"eu",
		"kyb",
		"b2b",
		"invoicing"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts",
		"!src/**/fixtures"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test --conditions=@voila.dev/source"
	},
	"dependencies": {
		"@voila.dev/http": "workspace:^"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@voila.dev/effect-ddd": "workspace:*",
		"@voila.dev/typescript-config": "workspace:*",
		"effect": "catalog:",
		"typescript": "catalog:"
	}
}
