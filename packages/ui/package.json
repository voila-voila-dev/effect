{
	"name": "@voila.dev/ui",
	"version": "0.0.0",
	"type": "module",
	"description": "One package, every component: the base set plus chart, datatable, spreadsheet, filter, map, landing, icon and the email block editor — subpath exports only, tree-shakeable by construction.",
	"license": "MIT",
	"homepage": "https://ui.voila.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/ui.git",
		"directory": "packages/ui"
	},
	"keywords": [
		"react",
		"ui",
		"components",
		"tailwindcss",
		"base-ui",
		"design-system",
		"charts",
		"datatable",
		"spreadsheet",
		"filters",
		"map",
		"maplibre",
		"email-editor",
		"landing"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.stories.ts",
		"!src/**/*.stories.tsx"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles/*.css": "./src/styles/*.css",
		"./lib/utils": "./src/lib/utils.ts",
		"./lib/time-math": "./src/lib/time-math.ts",
		"./cva": "./src/lib/cva.ts",
		"./badge-variants": "./src/components/badge-variants.ts",
		"./button-variants": "./src/components/button-variants.ts",
		"./menu-variants": "./src/components/menu-variants.ts",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./icon": "./src/icon/components/icon.tsx",
		"./chart/*": "./src/chart/components/*.tsx",
		"./chart/core/*": "./src/chart/core/*.ts",
		"./chart/hooks/*": "./src/chart/hooks/*.ts",
		"./datatable": "./src/datatable/components/data-table.tsx",
		"./spreadsheet/*": "./src/spreadsheet/components/*.tsx",
		"./spreadsheet/hooks/*": "./src/spreadsheet/hooks/*.ts",
		"./map/*": "./src/map/components/*.tsx",
		"./filter/*": "./src/filter/components/*.tsx",
		"./filter/types": "./src/filter/types.ts",
		"./filter/lib/*": "./src/filter/lib/*.ts",
		"./landing/*": "./src/landing/components/*.tsx",
		"./landing/tones": "./src/landing/lib/tones.ts",
		"./landing/landing.css": "./src/landing/styles/landing.css",
		"./landing/section-variants": "./src/landing/components/section-variants.ts",
		"./landing/container-variants": "./src/landing/components/container-variants.ts",
		"./landing/heading-variants": "./src/landing/components/heading-variants.ts",
		"./landing/text-variants": "./src/landing/components/text-variants.ts",
		"./email-block-editor": "./src/email-block-editor/email-block-editor.tsx",
		"./email-block-editor/theme": "./src/email-block-editor/theme.ts",
		"./email-block-editor/document/*": "./src/email-block-editor/document/*.ts",
		"./email-block-editor/blocks/*": "./src/email-block-editor/blocks/*.tsx",
		"./email-block-editor/sections/*": "./src/email-block-editor/sections/*.tsx",
		"./email-block-editor/dnd/*": "./src/email-block-editor/dnd/*.tsx"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "bun ../../scripts/build-package.mjs",
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"format": "biome format",
		"lint": "biome lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@phosphor-icons/react": "catalog:react",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cva": "^1.0.0-beta.4",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"react-day-picker": "^10.0.1",
		"react-resizable-panels": "^4.11.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0",
		"maplibre-gl": "^5.0.0",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.14.6",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2"
	},
	"peerDependenciesMeta": {
		"maplibre-gl": {
			"optional": true
		},
		"@tanstack/react-table": {
			"optional": true
		},
		"@tanstack/react-virtual": {
			"optional": true
		},
		"@dnd-kit/core": {
			"optional": true
		},
		"@dnd-kit/sortable": {
			"optional": true
		},
		"@dnd-kit/utilities": {
			"optional": true
		}
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.14.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@voila.dev/typescript-config": "workspace:*",
		"jsdom": "29.1.1",
		"maplibre-gl": "catalog:maplibre",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
