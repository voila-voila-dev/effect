---
/**
 * Replaces Starlight's default `SiteTitle`, which renders the logo as an
 * `<img>`. An `<img>`-referenced SVG cannot load a webfont, so a wordmark baked
 * into the SVG would fall back to whatever mono the OS happens to have. Here it
 * is real HTML text, which also means it picks up the theme colours and stays
 * kerned as one string instead of several positioned `<text>` elements.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
	<svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
		<rect width="32" height="32" rx="8"></rect>
		<path
			d="M10.2 10.4 16 21.6 21.8 10.4"
			stroke-width="3.6"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
	<span class="wordmark">ui.voila.dev</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0.625rem;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		.brand-mark {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			flex-shrink: 0;
		}
		/* Black tile, white v — and the reverse on dark, so the mark keeps its
		   contrast against the surface instead of disappearing into it. */
		.brand-mark rect {
			fill: #000000;
		}
		.brand-mark path {
			stroke: #ffffff;
		}
		:global([data-theme='dark']) .brand-mark rect {
			fill: #ffffff;
		}
		:global([data-theme='dark']) .brand-mark path {
			stroke: #000000;
		}
		.wordmark {
			font-family: var(--sl-font-mono);
			font-size: var(--sl-text-lg);
			font-weight: 600;
			letter-spacing: -0.03em;
			color: var(--sl-color-white);
			overflow: hidden;
		}
	}
</style>
