{
	"name": "@voila.dev/ui-email-block-editor",
	"version": "0.0.0",
	"type": "module",
	"description": "WYSIWYG block editor for marketing emails \u2014 an email-look canvas with drag-and-drop block reordering (dnd-kit)",
	"license": "MIT",
	"homepage": "https://ui.voila.dev/components/email-block-editor",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/ui.git",
		"directory": "packages/ui-email-block-editor"
	},
	"keywords": [
		"react",
		"email",
		"editor",
		"block-editor",
		"dnd-kit"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.stories.ts",
		"!src/**/*.stories.tsx"
	],
	"exports": {
		"./styles.css": "./src/styles.css",
		"./email-block-editor": "./src/email-block-editor.tsx",
		"./theme": "./src/theme.ts",
		"./document/*": "./src/document/*.ts",
		"./blocks/*": "./src/blocks/*.tsx",
		"./sections/*": "./src/sections/*.tsx",
		"./dnd/*": "./src/dnd/*.tsx"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"format": "biome format",
		"lint": "biome lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@phosphor-icons/react": "catalog:react",
		"@voila.dev/ui": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@voila.dev/typescript-config": "workspace:*",
		"jsdom": "29.1.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"sideEffects": [
		"**/*.css"
	]
}
