{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Written out rather than extending @voila.dev/typescript-config like the
	// rest of the monorepo: this file leaves with a clone, the shared one does not.
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["bun", "vite/client"],
		// Platform monorepo only: the @voila.dev packages resolve to their
		// sources. A cloned site deletes it and reads their published types.
		"customConditions": ["@voila.dev/source"]
	},
	"include": ["src", "vite", "docs.config.ts", "vite.config.ts"],
	"exclude": ["dist", "node_modules"]
}
