					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"slug": {
										"type": "object",
										"properties": {
											"fr-FR": {
												"type": "string",
												"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
											},
											"en-US": {
												"type": "string",
												"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
											}
										},
										"required": ["fr-FR", "en-US"],
										"additionalProperties": false
									},
									"label": {
										"type": "object",
										"properties": {
											"fr-FR": {
												"type": "string",
												"minLength": 1
											},
											"en-US": {
												"type": "string",
												"minLength": 1
											}
										},
										"required": ["fr-FR", "en-US"],
										"additionalProperties": false
									},
									"icon": {
										"type": "string",
										"minLength": 1
									},
									"labels": {
										"type": "array",
										"items": {
											"type": "string",
											"enum": [
												"backend",
												"design",
												"frontend",
												"infrastructure",
												"marketing",
												"mobile",
												"research"
											]
										}
									},
									"teams": {
										"type": "object",
										"properties": {
											"FR": {
												"type": "array",
												"items": {
													"type": "object",
													"properties": {
														"slug": {
															"type": "object",
															"properties": {
																"fr-FR": {
																	"type": "string",
																	"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
																},
																"en-US": {
																	"type": "string",
																	"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
																}
															},
															"required": ["fr-FR", "en-US"],
															"additionalProperties": false
														},
														"label": {
															"type": "object",
															"properties": {
																"fr-FR": {
																	"type": "string",
																	"minLength": 1
																},
																"en-US": {
																	"type": "string",
																	"minLength": 1
																}
															},
															"required": ["fr-FR", "en-US"],
															"additionalProperties": false
														},
														"visibility": {
															"type": "string",
															"enum": ["public", "private", "internal"]
														},
														"order": {
															"type": "integer",
															"minimum": 0
														}
													},
													"required": ["slug", "label", "visibility", "order"],
													"additionalProperties": false
												}
											}
										},
										"required": ["FR"],
										"additionalProperties": false
									}
								},
								"required": ["slug", "label", "icon", "labels", "teams"],
								"additionalProperties": false
							}
						}
					},
					"required": true
				}
