{
	"name": "@voila.dev/env",
	"version": "0.1.2",
	"description": "Load .env files into process.env or an Effect ConfigProvider: several files, earlier wins, the real environment always wins.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/effect.git",
		"directory": "packages/env"
	},
	"homepage": "https://github.com/voila-voila-dev/effect/tree/main/packages/env#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/effect/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"dotenv",
		"env",
		"config"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./effect": {
			"@voila.dev/source": "./src/effect.ts",
			"types": "./dist/effect.d.ts",
			"default": "./dist/effect.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"effect": "catalog:"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		}
	}
}
