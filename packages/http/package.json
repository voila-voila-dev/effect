{
	"name": "@voila.dev/http",
	"version": "0.1.1",
	"description": "Outbound HTTP for third-party integrations on Effect: timeouts, retries, spans, bounded reads, Schema decoding, a request log, and webhook signature checks.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "packages/http"
	},
	"homepage": "https://github.com/voila-voila-dev/platform/tree/main/packages/http#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/platform/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"http",
		"fetch",
		"retry",
		"ssrf",
		"webhooks",
		"stripe",
		"svix",
		"twilio",
		"sns"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./webhooks": {
			"@voila.dev/source": "./src/webhooks/index.ts",
			"types": "./dist/webhooks/index.d.ts",
			"default": "./dist/webhooks/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test --conditions=@voila.dev/source"
	},
	"dependencies": {
		"@voila.dev/crypto": "workspace:^"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@voila.dev/effect-ddd": "workspace:*",
		"typescript": "catalog:",
		"effect": "catalog:"
	}
}
