{
	"name": "@voila.dev/live",
	"version": "0.0.0",
	"description": "Live updates over WebSocket on Effect: channels with a gate and a filter, a batching socket hub, a replay log on Redis streams, and a reconnecting browser client.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/effect.git",
		"directory": "packages/live"
	},
	"homepage": "https://github.com/voila-voila-dev/effect/tree/main/packages/live#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/effect/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"websocket",
		"live",
		"realtime",
		"redis-streams"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"@voila.dev/source": "./src/client/index.ts",
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./redis": {
			"@voila.dev/source": "./src/redis/index.ts",
			"types": "./dist/redis/index.d.ts",
			"default": "./dist/redis/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test --conditions=@voila.dev/source"
	},
	"dependencies": {
		"@voila.dev/effect-ddd": "workspace:^"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"effect": "catalog:"
	}
}
