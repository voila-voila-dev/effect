---
/**
 * Frames a live example so every component page presents its previews the same
 * way. An Astro component rather than a React one, so the examples inside stay
 * ordinary islands: `<Preview><Variants client:load /></Preview>`. Nesting React
 * components directly inside a React island from MDX does not work — the
 * children arrive as Astro JSX, which React cannot render.
 */
interface Props {
	/** Short caption above the example, e.g. "Sizes" or "Disabled". */
	label?: string;
	/** `row` wraps the examples inline; `stack` gives each its own full width. */
	layout?: "row" | "stack" | "center";
	/** Let a wide example scroll inside the frame instead of the page. */
	scroll?: boolean;
}

const { label, layout = "row", scroll = false } = Astro.props;

const stageClass = [
	"preview__stage",
	layout === "stack" ? "preview__stage--stack" : "",
	layout === "center" ? "preview__stage--center" : "",
]
	.filter(Boolean)
	.join(" ");
---

<div class:list={["preview", "not-content", scroll && "preview--scroll"]}>
	{label && <p class="preview__label">{label}</p>}
	<div class={stageClass}><slot /></div>
</div>
