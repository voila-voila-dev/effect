{
	"name": "@voila.dev/ui-chart",
	"version": "0.0.0",
	"type": "module",
	"description": "Charts with zero charting library. SVG you can read, scales included.",
	"license": "MIT",
	"homepage": "https://ui.voila.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/ui.git",
		"directory": "packages/ui-chart"
	},
	"keywords": [
		"react",
		"charts",
		"svg",
		"dataviz",
		"tailwindcss"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.stories.ts",
		"!src/**/*.stories.tsx"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./src/styles.css",
		"./components/*": "./src/components/*.tsx",
		"./core/*": "./src/core/*.ts",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"format": "biome format",
		"lint": "biome lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@voila.dev/ui": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@voila.dev/typescript-config": "workspace:*",
		"jsdom": "29.1.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
