{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/dist",
			"!.changeset/*.md",
			"!packages/biome-plugins/rules/fixtures",
			"!**/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"plugins": [
		{
			"path": "./packages/biome-plugins/rules/no-data-tagged-error.grit",
			"includes": [
				"**/packages/*/src/**",
				"!**/packages/ui/**",
				"!**/packages/chart/**",
				"!**/packages/motion/**",
				"!**/packages/ui-branding/**"
			]
		},
		{
			"path": "./packages/biome-plugins/rules/no-math-random.grit",
			"includes": [
				"**/packages/*/src/**",
				"!**/*.test.ts",
				"!**/packages/ui/**",
				"!**/packages/chart/**",
				"!**/packages/motion/**",
				"!**/packages/ui-branding/**"
			]
		},
		{
			"path": "./packages/biome-plugins/rules/no-random-uuid.grit",
			"includes": [
				"**/packages/*/src/**",
				"!**/*.test.ts",
				"!**/*.test-helper.ts",
				"!**/packages/ui/**",
				"!**/packages/chart/**",
				"!**/packages/motion/**",
				"!**/packages/ui-branding/**"
			]
		},
		{
			"path": "./packages/biome-plugins/rules/no-schema-disable-checks.grit",
			"includes": [
				"**/packages/*/src/**",
				"!**/*.test.ts",
				"!**/*.test-helper.ts",
				"!**/packages/ui/**",
				"!**/packages/chart/**",
				"!**/packages/motion/**",
				"!**/packages/ui-branding/**"
			]
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/ui/src/accordion/components/**",
				"packages/ui/src/button-group/components/**",
				"packages/ui/src/carousel/components/**",
				"packages/ui/src/chat/components/**",
				"packages/ui/src/color-picker/components/**",
				"packages/ui/src/copyable-text/components/**",
				"packages/ui/src/field/components/**",
				"packages/ui/src/image-cropper/components/**",
				"packages/ui/src/input-group/components/**",
				"packages/ui/src/input-otp/components/**",
				"packages/ui/src/rating/components/**",
				"packages/ui/src/components/**",
				"packages/ui/src/chart/components/**",
				"packages/ui/src/data-table/**",
				"packages/ui/src/spreadsheet/components/**",
				"packages/ui/src/globe-view/components/**",
				"packages/ui/src/map-view/components/**",
				"packages/ui/src/radius-map/components/**",
				"packages/ui/src/filter/components/**",
				"packages/ui/src/content-editor/**"
			],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off",
						"useFocusableInteractive": "off",
						"useAriaPropsForRole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/ui/src/carousel/components/**",
				"packages/ui/src/chat/components/**",
				"packages/ui/src/kbd/components/**",
				"packages/ui/src/rating/components/**",
				"packages/ui/src/components/**",
				"packages/ui/src/chart/components/**",
				"packages/ui/src/data-table/**",
				"packages/ui/src/sidebar/components/**",
				"packages/ui/src/slider/components/**",
				"packages/ui/src/spreadsheet/**",
				"packages/ui/src/landing/components/**",
				"packages/ui/src/content-editor/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					}
				}
			}
		}
	]
}
