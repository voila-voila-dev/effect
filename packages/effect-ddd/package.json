{
	"name": "@voila.dev/effect-ddd",
	"version": "0.0.0",
	"description": "Use cases, gates and architecture tests for domain-driven, hexagonal applications on Effect.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/effect.git",
		"directory": "packages/effect-ddd"
	},
	"homepage": "https://github.com/voila-voila-dev/effect/tree/main/packages/effect-ddd#readme",
	"keywords": [
		"effect",
		"effect-ts",
		"ddd",
		"domain-driven-design",
		"hexagonal",
		"clean-architecture",
		"use-case"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./architecture": {
			"@voila.dev/source": "./src/architecture/index.ts",
			"types": "./dist/architecture/index.d.ts",
			"default": "./dist/architecture/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"effect": "catalog:"
	}
}
