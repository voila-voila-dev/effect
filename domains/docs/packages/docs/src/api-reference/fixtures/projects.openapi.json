							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DatabaseErrorEncoded"
								}
							}
						}
					}
				},
				"description": "Public: no session is required, so the rate-limit budget is keyed on the caller's IP address.",
				"summary": "Search the project catalog",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"filter": {
										"type": "object",
										"properties": {
											"search": {
												"anyOf": [
													{
														"type": "string",
														"maxLength": 128
													},
													{
														"type": "null"
													}
												]
											},
											"createdAtFrom": {
												"anyOf": [
													{
														"type": "string"
													},
													{
														"type": "null"
													}
												]
											},
											"createdAtTo": {
												"anyOf": [
													{
														"type": "string"
													},
													{
														"type": "null"
													}
												]
											},
											"sortBy": {
												"anyOf": [
													{
														"type": "string",
														"enum": ["createdAt", "slug"]
													},
													{
														"type": "null"
													}
												]
											},
											"sortDirection": {
												"anyOf": [
													{
														"type": "string",
														"enum": ["asc", "desc"]
													},
													{
														"type": "null"
													}
												]
											}
										},
										"additionalProperties": false
									},
									"pagination": {
										"type": "object",
										"properties": {
											"take": {
												"type": "integer",
												"minimum": 1,
												"maximum": 100
											},
											"skip": {
												"type": "integer"
											}
										},
										"required": ["take", "skip"],
										"additionalProperties": false
									}
								},
								"required": ["filter", "pagination"],
								"additionalProperties": false
							}
						}
					},
					"required": true
				}
			}
		},
