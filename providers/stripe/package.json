{
	"name": "@voila.dev/stripe",
	"version": "0.0.0",
	"description": "A light Stripe REST client on Effect: a pinned API version, nested form encoding, retries only when safe, Stripe's errors read (created nothing? card declined?), field readers, the webhook event schema and a scripted fake.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "providers/stripe"
	},
	"homepage": "https://github.com/voila-voila-dev/platform/tree/main/providers/stripe#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/platform/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"stripe",
		"payments",
		"rest",
		"webhooks",
		"idempotency"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test --conditions=@voila.dev/source"
	},
	"dependencies": {
		"@voila.dev/http": "workspace:^"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@voila.dev/effect-ddd": "workspace:*",
		"@voila.dev/typescript-config": "workspace:*",
		"effect": "catalog:",
		"typescript": "catalog:"
	}
}
