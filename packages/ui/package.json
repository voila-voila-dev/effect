{
	"name": "@voila.dev/ui",
	"version": "0.0.0",
	"type": "module",
	"description": "Source-shipped React component library built on Base UI, Tailwind CSS 4 and Phosphor icons",
	"license": "MIT",
	"homepage": "https://ui.voila.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/ui.git",
		"directory": "packages/ui"
	},
	"keywords": [
		"react",
		"ui",
		"components",
		"tailwindcss",
		"base-ui",
		"design-system"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.stories.ts",
		"!src/**/*.stories.tsx"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./src/styles.css",
		"./styles/globals.css": "./src/styles/globals.css",
		"./lib/utils": "./src/lib/utils.ts",
		"./lib/time-math": "./src/lib/time-math.ts",
		"./cva": "./src/lib/cva.ts",
		"./badge-variants": "./src/components/ui/badge-variants.ts",
		"./button-variants": "./src/components/ui/button-variants.ts",
		"./menu-variants": "./src/components/ui/menu-variants.ts",
		"./components/*": "./src/components/ui/*.tsx",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"format": "biome format",
		"lint": "biome lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@phosphor-icons/react": "catalog:react",
		"@voila.dev/ui-icon": "workspace:*",
		"@voila.dev/ui-tokens": "workspace:*",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cva": "^1.0.0-beta.4",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"react-day-picker": "^10.0.1",
		"react-resizable-panels": "^4.11.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@voila.dev/typescript-config": "workspace:*",
		"jsdom": "29.1.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
