{
	"name": "@voila.dev/script-kit",
	"version": "0.0.0",
	"description": "The foundation of Bun tooling scripts on Effect: one runScript entrypoint with env files loaded, dry-run-by-default --commit and --limit flags, a failure the runtime renders, subprocesses in the foreground or as text, and GitHub Actions outputs.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "packages/script-kit"
	},
	"homepage": "https://github.com/voila-voila-dev/platform/tree/main/packages/script-kit#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/platform/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"bun",
		"cli",
		"scripts"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@voila.dev/env": "workspace:^"
	},
	"peerDependencies": {
		"@effect/platform-bun": "^4.0.0",
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@effect/platform-bun": "catalog:",
		"@types/bun": "catalog:",
		"@voila.dev/effect-ddd": "workspace:*",
		"effect": "catalog:",
		"typescript": "catalog:"
	}
}
