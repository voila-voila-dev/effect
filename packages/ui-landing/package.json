{
	"name": "@voila.dev/ui-landing",
	"version": "0.0.0",
	"type": "module",
	"description": "Composable marketing and landing page sections built on @voila.dev/ui",
	"license": "MIT",
	"homepage": "https://ui.voila.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/ui.git",
		"directory": "packages/ui-landing"
	},
	"keywords": [
		"react",
		"landing-page",
		"marketing",
		"sections",
		"tailwindcss"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.stories.ts",
		"!src/**/*.stories.tsx"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./styles.css": "./src/styles.css",
		"./styles/landing.css": "./src/styles/landing.css",
		"./lib/tones": "./src/lib/tones.ts",
		"./section-variants": "./src/components/section-variants.ts",
		"./container-variants": "./src/components/container-variants.ts",
		"./heading-variants": "./src/components/heading-variants.ts",
		"./text-variants": "./src/components/text-variants.ts",
		"./components/*": "./src/components/*.tsx"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"check": "biome check",
		"check-types": "tsc --noEmit",
		"format": "biome format",
		"lint": "biome lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@phosphor-icons/react": "catalog:react",
		"@voila.dev/ui": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@voila.dev/typescript-config": "workspace:*",
		"jsdom": "29.1.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
