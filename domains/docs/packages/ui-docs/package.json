{
	"name": "@voila.dev/ui-docs",
	"version": "0.1.0",
	"description": "The React layer of a documentation site on @voila.dev/docs: frame, sidebar, outline, search palette, reader context, MDX components and API reference pages, on Tailwind CSS 4 and Base UI.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "domains/docs/packages/ui-docs"
	},
	"homepage": "https://github.com/voila-voila-dev/platform/tree/main/domains/docs/packages/ui-docs#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/platform/issues"
	},
	"keywords": [
		"documentation",
		"docs",
		"react",
		"tailwindcss",
		"mdx",
		"openapi"
	],
	"exports": {
		"./styles/docs.css": "./src/styles/docs.css",
		"./components/*": {
			"@voila.dev/source": "./src/components/*.tsx",
			"types": "./dist/components/*.d.ts",
			"default": "./dist/components/*.js"
		},
		"./lib/*": {
			"@voila.dev/source": "./src/lib/*.ts",
			"types": "./dist/lib/*.d.ts",
			"default": "./dist/lib/*.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.test-helper.tsx"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test --conditions=@voila.dev/source"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@voila.dev/docs": "workspace:^",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"peerDependencies": {
		"@phosphor-icons/react": "^2.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.14.6",
		"@phosphor-icons/react": "catalog:react",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "catalog:",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@voila.dev/effect-ddd": "workspace:^",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"typescript": "catalog:"
	}
}
