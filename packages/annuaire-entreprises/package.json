{
	"name": "@voila.dev/annuaire-entreprises",
	"version": "0.0.0",
	"description": "The French company directory (Annuaire des Entreprises) on Effect: a SIRET to its company, directors and address, a name search, typed outages, and an in-memory fake.",
	"license": "MIT",
	"author": "voila.dev",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/platform.git",
		"directory": "packages/annuaire-entreprises"
	},
	"homepage": "https://github.com/voila-voila-dev/platform/tree/main/packages/annuaire-entreprises#readme",
	"bugs": {
		"url": "https://github.com/voila-voila-dev/platform/issues"
	},
	"keywords": [
		"effect",
		"effect-ts",
		"siret",
		"siren",
		"insee",
		"sirene",
		"annuaire-entreprises",
		"recherche-entreprises",
		"kyb",
		"france"
	],
	"exports": {
		".": {
			"@voila.dev/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-helper.ts",
		"!src/**/fixtures"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test --conditions=@voila.dev/source"
	},
	"dependencies": {
		"@voila.dev/http": "workspace:^"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@voila.dev/effect-ddd": "workspace:*",
		"effect": "catalog:",
		"typescript": "catalog:"
	}
}
