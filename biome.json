{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/dist",
			"!.changeset/*.md",
			"!packages/biome-plugins/rules/fixtures"
		]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"plugins": [
		{
			"path": "./packages/biome-plugins/rules/no-data-tagged-error.grit",
			"includes": ["**/packages/*/src/**"]
		},
		{
			"path": "./packages/biome-plugins/rules/no-math-random.grit",
			"includes": ["**/packages/*/src/**", "!**/*.test.ts"]
		},
		{
			"path": "./packages/biome-plugins/rules/no-random-uuid.grit",
			"includes": [
				"**/packages/*/src/**",
				"!**/*.test.ts",
				"!**/*.test-helper.ts"
			]
		},
		{
			"path": "./packages/biome-plugins/rules/no-schema-disable-checks.grit",
			"includes": [
				"**/packages/*/src/**",
				"!**/*.test.ts",
				"!**/*.test-helper.ts"
			]
		}
	],
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	}
}
